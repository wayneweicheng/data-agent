# Google Cloud project that owns the BigQuery dataset and pays for queries.
GOOGLE_CLOUD_PROJECT=ark-of-data-2000

# Keep this aligned with the dataset location and DATA_AGENT_LOCATION below.
# "us" is a BigQuery multi-region and is a simple choice for this demo.
BIGQUERY_LOCATION=US
DATA_AGENT_LOCATION=us

# Names are intentionally easy to recognize in the BigQuery console.
BIGQUERY_DATASET=retail_agent_demo
DATA_AGENT_ID=retail-analyst-demo

# Local OpenMetadata (started with scripts/openmetadata.py start).
OPENMETADATA_VERSION=1.13.0
OPENMETADATA_HOST=http://localhost:8585/api
# Create a bot token in OpenMetadata: Settings > Bots > ingestion-bot.
OPENMETADATA_JWT_TOKEN=

# Optional: only needed if you are not using gcloud application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
